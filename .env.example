# Local dev secrets for `wrangler pages dev` — rename this file to `.dev.vars`.
# In production, push secrets with: ./cf-deploy.sh --secrets
# Get keys from: https://console.groq.com/keys and https://github.com/settings/tokens

GROQ_API_KEY="gsk_your_groq_api_key_here"

# Optional — defaults to openai/gpt-oss-120b
# GROQ_MODEL="openai/gpt-oss-120b"

# Optional — without this, GitHub API requests are rate-limited
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"
